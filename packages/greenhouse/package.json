{
  "name": "@adeeeeta/greenhouse",
  "version": "1.2.0",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./dist/greenhouse.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "vite build",
    "docs:validate": "dsds-validate docs/index.dsds.yaml docs/components/*.dsds.yaml docs/tokens/*.dsds.yaml docs/themes/*.dsds.yaml",
    "docs:lint": "dsds-lint docs/index.dsds.yaml docs/components/*.dsds.yaml docs/tokens/*.dsds.yaml docs/themes/*.dsds.yaml",
    "docs:format": "dsds-format docs",
    "docs:todos": "! grep -rn 'TODO(adi)' docs",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "npm run docs:validate && npm run docs:todos && npm run docs:build -- --check",
    "prepublishOnly": "npm run docs:check && npm run build"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "design-system-documentation-schema": "github:somerandomdude/design-system-documentation-schema#cd6d817e81d4e5f0cc1fb98ae7636379408014d7",
    "rollup-preserve-directives": "^1.1.3",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "yaml": "^2.9.1"
  }
}